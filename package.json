{
  "name": "trickcal-tools-clone",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && bun run pages:routes",
    "data:update": "bun scripts/update-all-data.ts",
    "data:update:community": "bun scripts/update-community-data.ts",
    "data:update:sweep": "bun scripts/update-sweep-data.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "pages:routes": "bun scripts/create-pages-routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.2",
    "postcss": "8.5.30"
  }
}
